# --- API ---
DATABASE_URL=postgresql+psycopg://ceklis:ceklis@localhost:5432/ceklis
# Dipakai pytest; database dibuat otomatis oleh infra/initdb
TEST_DATABASE_URL=postgresql+psycopg://ceklis:ceklis@localhost:5432/ceklis_test
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=ganti-dengan-string-acak-panjang
# false hanya untuk dev lokal tanpa HTTPS
SESSION_COOKIE_SECURE=false
APP_BASE_URL=https://ceklis.nopol-lpr.com
APP_TZ=Asia/Jakarta

# Storage foto (S3-compatible). Dev: MinIO dari docker-compose.
S3_ENDPOINT=http://localhost:9000
# Endpoint yang dipakai browser untuk presigned URL (boleh beda dengan S3_ENDPOINT di dalam docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=ceklis-photos
S3_ACCESS_KEY=ceklis
S3_SECRET_KEY=ceklis-secret
S3_REGION=us-east-1

# Scan plat lewat engine Nopol (kosongkan NOPOL_API_URL = scan mati, petugas ketik manual).
# Engine lokal / server klien (container nopol-engine), tanpa login:
#   NOPOL_API_URL=http://localhost:8001   (dari container docker: http://host.docker.internal:8001)
#   NOPOL_RECOGNIZE_PATH=/recognize
# API cloud Nopol (butuh salah satu cara login):
#   NOPOL_API_URL=https://api.nopol-lpr.com  NOPOL_RECOGNIZE_PATH=/api/playground/recognize
#   NOPOL_API_TOKEN=… (Bearer)  atau  NOPOL_EMAIL=… + NOPOL_PASSWORD=…
NOPOL_API_URL=http://localhost:8001
NOPOL_RECOGNIZE_PATH=/recognize
NOPOL_API_TOKEN=
NOPOL_EMAIL=
NOPOL_PASSWORD=

PHOTO_MAX_PX=1600
PHOTO_RETENTION_DAYS=90

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=/api
# Alamat API dari server Next.js (rewrite /api/* ke FastAPI)
API_INTERNAL_URL=http://localhost:8000
