# Salin ke .env.production di root repo (JANGAN di-commit). Isi semua nilai <...>.
# Buat string acak: openssl rand -hex 32

POSTGRES_PASSWORD=<acak>
SESSION_SECRET=<acak>
APP_BASE_URL=https://ceklis.nopol-lpr.com
APP_TZ=Asia/Jakarta

# Storage foto (RustFS di compose). Endpoint publik = subdomain yang diarahkan Caddy ke 127.0.0.1:9030
S3_PUBLIC_ENDPOINT=https://ceklis-files.nopol-lpr.com
S3_BUCKET=ceklis-photos
S3_ACCESS_KEY=ceklis
S3_SECRET_KEY=<acak>
S3_REGION=us-east-1

# Scan plat: API recognize Nopol + API key lokasi (Dashboard Nopol → lokasi → Lisensi & Integrasi → API key)
NOPOL_API_URL=https://api.nopol-lpr.com
NOPOL_RECOGNIZE_PATH=/api/v1/recognize
NOPOL_API_TOKEN=<npk_...>

PHOTO_MAX_PX=1600
PHOTO_RETENTION_DAYS=90

# Super admin pertama (dibuat sekali saat start kalau belum ada super admin). Ganti password setelah login.
SEED_ADMIN_EMAIL=<email-admin>
SEED_ADMIN_PASSWORD=<password-awal-kuat>

# Port lokal VPS yang dipakai Caddy (cek dulu: ss -tlnp | grep LISTEN)
CEKLIS_WEB_PORT=3030
CEKLIS_FILES_PORT=9030
